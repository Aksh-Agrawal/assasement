# Copy to /etc/assessdev/device.env; systemd reads it as an EnvironmentFile.
# Shell users may export these values. Python does not implicitly load .env files.
# Empty API URL keeps the device offline. Set your cloud origin when available.
ASSESS_API_URL=
ASSESS_DATA_DIR=/var/lib/assessdev
ASSESS_SQLITE_PATH=/var/lib/assessdev/assessment-device.db
ASSESS_CREDENTIAL_PATH=/var/lib/assessdev/device_credentials.json
ASSESS_PACK_DIR=/var/lib/assessdev/packs
ASSESS_UPDATE_DIR=/var/lib/assessdev/updates
ASSESS_DOWNLOAD_DIR=/var/lib/assessdev/downloads/tmp
ASSESS_LOG_DIR=/var/lib/assessdev/log
ASSESS_SYNC_INTERVAL=60
ASSESS_HEARTBEAT_INTERVAL=300
ASSESS_CONNECT_TIMEOUT=5
ASSESS_READ_TIMEOUT=15
