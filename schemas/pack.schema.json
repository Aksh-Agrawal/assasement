{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offline-assessment.local/schemas/pack.schema.json",
  "title": "Offline-First Student Assessment Question Pack",
  "description": "Phase 0 contract for schema version 1 single-correct four-option question packs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "set",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "content_status": {
      "type": "string",
      "enum": [
        "development_fixture",
        "production"
      ]
    },
    "content_notice": {
      "type": "string",
      "minLength": 1
    },
    "set": {
      "$ref": "#/$defs/question_set"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/question" },
          { "$ref": "#/$defs/numeric_question" }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 1 } } },
      "then": {
        "properties": { "questions": { "items": {
          "$ref": "#/$defs/question",
          "not": { "required": ["solution_ref"] }
        } } }
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "question_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "subject",
        "chapter",
        "marking"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "chapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "marking": {
          "$ref": "#/$defs/marking"
        }
      }
    },
    "marking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct",
        "wrong",
        "skip"
      ],
      "properties": {
        "correct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wrong": {
          "type": "number",
          "maximum": 0
        },
        "skip": {
          "type": "number",
          "maximum": 0
        }
      }
    },
    "option_a": {
      "allOf": [
        {
          "$ref": "#/$defs/option"
        },
        {
          "properties": {
            "key": {
              "const": "A"
            }
          }
        }
      ]
    },
    "option_b": {
      "allOf": [
        {
          "$ref": "#/$defs/option"
        },
        {
          "properties": {
            "key": {
              "const": "B"
            }
          }
        }
      ]
    },
    "option_c": {
      "allOf": [
        {
          "$ref": "#/$defs/option"
        },
        {
          "properties": {
            "key": {
              "const": "C"
            }
          }
        }
      ]
    },
    "option_d": {
      "allOf": [
        {
          "$ref": "#/$defs/option"
        },
        {
          "properties": {
            "key": {
              "const": "D"
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "text"
      ],
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "solution_ref": {
      "type": "string",
      "pattern": "^media/[0-9a-f]{64}[.]png$"
    },
    "numeric_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "topic",
        "difficulty",
        "question_text",
        "options",
        "correct_key",
        "media_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "question_text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "maxItems": 0
        },
        "correct_key": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$"
        },
        "solution_ref": { "$ref": "#/$defs/solution_ref" },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "media_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "topic",
        "difficulty",
        "question_text",
        "options",
        "correct_key",
        "media_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "question_text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/option_a"
            },
            {
              "$ref": "#/$defs/option_b"
            },
            {
              "$ref": "#/$defs/option_c"
            },
            {
              "$ref": "#/$defs/option_d"
            }
          ],
          "items": false
        },
        "correct_key": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "solution_ref": { "$ref": "#/$defs/solution_ref" },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "media_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
