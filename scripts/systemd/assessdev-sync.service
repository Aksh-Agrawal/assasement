[Unit]
Description=Assessment device background sync
After=network.target

[Service]
Type=simple
User=assess
Group=assess
WorkingDirectory=/opt/assessment-device
EnvironmentFile=/etc/assessdev/device.env
ExecStart=/opt/assessment-device/.venv/bin/python -m app.sync.service
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
