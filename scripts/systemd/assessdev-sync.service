[Unit]
Description=Assessment device background sync
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=/
EnvironmentFile=/etc/assessdev/device.env
ExecStart=/usr/local/libexec/assessdev-run-sync
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
