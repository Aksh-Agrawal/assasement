[Unit]
Description=Assessment device graphical kiosk
After=systemd-user-sessions.service
Requires=assessdev-recover.service
After=assessdev-recover.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
PAMName=login
WorkingDirectory=/
EnvironmentFile=/etc/assessdev/device.env
Environment=SDL_VIDEODRIVER=x11
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QT_QPA_PLATFORM=xcb
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
ExecStart=/usr/local/libexec/assessdev-launch-ui
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
