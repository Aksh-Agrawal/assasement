# PostgreSQL backend persistence. Replace placeholders only in an untracked .env file or shell.
DATABASE_URL=postgresql+psycopg://assessment_app:CHANGE_ME@localhost:5432/assessment_dev

# Dedicated PostgreSQL database only; postgres-marked tests reject names without "test".
TEST_DATABASE_URL=postgresql+psycopg://assessment_app:CHANGE_ME@localhost:5432/assessment_test

# Short-lived pairing-code TTL; development approval is a local CLI command.
ASSESS_PAIRING_CODE_TTL_SECONDS=600
